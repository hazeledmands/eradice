# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json

# QA screenshots
*.png

# Yarn's install cache. Regenerated by every `yarn install` and rewritten even
# when nothing changed, so tracking it means a dirty tree after any install.
# Not needed for reproducibility — yarn.lock is what pins versions — and
# .dockerignore already keeps it out of the image.
/.yarn/install-state.gz

# beads issue tracker (removed; keep its daemon from re-adding state)
.beads/

# Supabase export (real player data — never commit)
supabase-data.sql
*.supabase.json
